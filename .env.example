# Postgres (Neon). Use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Private GHL Marketplace app (agency-level; see README §2).
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Optional: only if discovery reports an appId problem (defaults to the Client ID prefix before "-").
GHL_APP_ID=

# Dashboard login password (min 8 chars).
DASHBOARD_PASSWORD=

# Signs the session cookie and encrypts stored GHL tokens. Min 32 chars: openssl rand -base64 48
SESSION_SECRET=
