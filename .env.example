# Postgres (Neon). Use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# One GHL Private Integration Token per sub-account (read-only scopes; see README).
GHL_TOKEN_A=
GHL_TOKEN_B=
GHL_TOKEN_C=
GHL_TOKEN_D=

# Dashboard login password (min 8 chars).
DASHBOARD_PASSWORD=

# Signs the session cookie. Min 32 chars: openssl rand -base64 48
SESSION_SECRET=
